# Copy this file to .env for local development with `netlify dev`,
# and set the same variable in the Netlify dashboard (Site settings →
# Environment variables) for production. Never commit the real value.

GEMINI_API_KEY=

# Optional — defaults to gemini-2.5-flash if unset. Override if that model
# isn't available for your key, without needing a code change/redeploy.
GEMINI_MODEL=
